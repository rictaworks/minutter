{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minutter",
  "version": "0.1.1",
  "identifier": "jp.ricta.minutter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "minutter",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "models/vosk-model-ja/README": "models/vosk-model-ja/README",
      "models/vosk-model-ja/am/*": "models/vosk-model-ja/am",
      "models/vosk-model-ja/conf/*": "models/vosk-model-ja/conf",
      "models/vosk-model-ja/graph/phones/*": "models/vosk-model-ja/graph/phones",
      "models/vosk-model-ja/graph/*": "models/vosk-model-ja/graph",
      "models/vosk-model-ja/ivector/*": "models/vosk-model-ja/ivector",
      "models/vosk-model-ja/rescore/*": "models/vosk-model-ja/rescore",
      "binaries/ffmpeg.exe": "binaries/ffmpeg.exe",
      "libs/libvosk.dll": "libvosk.dll",
      "libs/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "libs/libstdc++-6.dll": "libstdc++-6.dll",
      "libs/libwinpthread-1.dll": "libwinpthread-1.dll"
    }
  }
}
